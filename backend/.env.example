# ---------------------------------------------------------------- General
ENVIRONMENT=development
DEBUG=false
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Set true only when running behind a trusted reverse proxy (nginx) that sets X-Forwarded-For
TRUSTED_PROXIES=false

# ---------------------------------------------------------------- Database (MySQL 8 / MariaDB 10.6+)
DATABASE_URL=mysql+pymysql://ticketing:ticketing@localhost:3306/ticketing?charset=utf8mb4
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ---------------------------------------------------------------- JWT (generate with: python -c "import secrets;print(secrets.token_urlsafe(64))")
JWT_SECRET_KEY=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
# REFRESH_COOKIE_DOMAIN=.example.com

# ---------------------------------------------------------------- Security
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
RATE_LIMIT_DEFAULT=300/minute
RATE_LIMIT_AUTH=10/minute
# Optional: shared rate-limit storage for multiple API instances
# REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------- Uploads
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=10
MAX_FILES_PER_MESSAGE=5

# ---------------------------------------------------------------- SMS (Kavenegar)
# console = log messages only (development), kavenegar = real sending, disabled = off
SMS_PROVIDER=console
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
# true = use Verify Lookup templates defined in the Kavenegar panel (recommended for OTP)
KAVENEGAR_USE_VERIFY_LOOKUP=false

# ---------------------------------------------------------------- Email (SMTP)
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
EMAIL_FROM=support@example.com
EMAIL_FROM_NAME=پشتیبانی

# ---------------------------------------------------------------- Background jobs
ENABLE_SCHEDULER=true
SLA_CHECK_INTERVAL_SECONDS=60
